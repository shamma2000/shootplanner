APP_NAME=ShootPlanner API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://shootplanner:change-me@localhost:5432/shootplanner
DATABASE_ECHO=false
